@model Author

<div>
    <h4>
        @Model?.AuthorName
    </h4>
    <div>
        <div class="col border border-black card-body">
            @foreach (var book_item in Model.Books)
            {
                <div class="border border-black">
                    <p>@book_item?.BookTitle</p>
                    <p>@book_item?.BookDescription</p>
                    @foreach (var author_item in book_item.Authors)
                    {
                        <p>@author_item?.AuthorName</p>
                    }
                </div>
            }
        </div>
    </div>
</div>