@model Author

<form asp-action="Create" asp-controller="Author" class="border border-black p-3 mb-3 col-6">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="form-group">
        <div class="mb-3 col-3">
            <label asp-for="AuthorName" class="control-label">Enter Author Name</label>
            <input asp-for="AuthorName" class="form-control" />
            <span asp-validation-for="AuthorName" class="text-danger"/>
        </div>
    </div>
    <button class="btn btn-primary">Add</button>
</form>