@model AuthorsListViewModels

<div class="m-2">
    <div>
        <a class="btn btn-success btn-sm text-black" asp-controller="Author" asp-action="Create">Create Author</a>
    </div>

    <div class="container text-center">
        @foreach (var p in Model?.Authors ?? Enumerable.Empty<Author>())
        {
            <partial name="AuthorSummary" model="p" />
        }
    </div>

</div>

<div page-model="@Model?.PagingInfo" page-action="Index" page-classes-enabled="true"
     page-class="btn" page-class-normal="btn-outline-dark"
     page-class-selected="btn-primary" class="btn-group pull-right m-1">
</div>
