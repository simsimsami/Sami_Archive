@model Author

<form asp-action="DeleteAuthor" asp-route-AuthorID="model?.AuthorID" method="post" class="border border-black p-3 mb-3 col-6">
    <input asp-for="AuthorID" type="hidden" />
    <div class="form-group">
        <div class="mb-3 col-3">
            <label asp-for="AuthorName" class="form-label"></label>
            <input asp-for="AuthorName" class="form-control" />
        </div>
    </div>
    <button class="btn btn-danger">Confirm?</button>
</form>