@model Genre

<form asp-action="Create" method="post" class="border border-black p-3 mb-3 col-6">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="form-group">
        <div class="col mx-auto p-2">
            <label asp-for="GenreTitle" class="control-label">Enter Genre Title</label>
            <input asp-for="GenreTitle" class="form-control" />
            <span asp-validation-for="GenreTitle" class="text-danger" />
        </div>
    </div>
    <button class="btn btn-primary">Add</button>
</form>
