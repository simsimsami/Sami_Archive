@model Genre

<form asp-action="Edit" asp-route-BookID="@Model?.GenreID" method="post" class="border border-black p-3 mb-3 col-6">
    <input asp-for="GenreID" type="hidden" />
    <div class="form-group">
        <div class="mb-3 col-3">
            <label asp-for="GenreTitle" class="form-label"></label>
            <input asp-for="GenreTitle" class="form-control" />
        </div>
    </div>
    <button class="btn btn-primary">Update</button>
</form>
