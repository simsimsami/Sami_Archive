@model CreateBookViewModel

<form asp-action="Create" method="post" class="border border-black p-3 mb-3 col-6">
    <div class="form-group">
        <div class="mb-3 col-3">
            <label asp-for="BookTitle" class="form-label">Book Title</label>
            <input asp-for="BookTitle" class="form-control" />
        </div>
    </div>
    <div class="form-group">
        <label asp-for="SelectedGenreId">Select Genre</label>
        <select asp-for="SelectedGenreId"
                asp-items="@(new MultiSelectList(Model.Genres, "Key", "Value"))"
                class="form-control"
                multiple>
        </select>

    </div>
    <div class="form-group">
        <label asp-for="SelectedAuthorId">Select Author</label>
        <select asp-for="SelectedAuthorId"
                asp-items="@(new MultiSelectList(Model.Authors, "Key", "Value"))"
                class="form-control"
                multiple>
        </select>
    </div>
    <div class="form-group">
        <div class="mb-3">
            <label asp-for="BookDescription" class="form-label">Book Description</label>
            <input asp-for="BookDescription" class="form-control" />
        </div>
    </div>
    <button class="btn btn-primary">Add</button>
</form>
