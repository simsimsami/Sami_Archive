@model CreateBookViewModel

<form asp-action="Create" asp-controller="Book" class="border border-black p-3 mb-3 col-6">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="form-group">
        <div class="mb-3">
            <label asp-for="BookTitle" class="control-label">Enter Book Title</label>
            <input asp-for="BookTitle" class="form-control" />
            <span asp-validation-for="BookTitle" class="text-danger" />
        </div>
    </div>    <label asp-for="SelectedAuthors">Select Genres</label>
    <div class="form-group border border-black rounded">
        @foreach (var genre in Model?.Genres)
        {
            <div class="form-check">
                <input type="checkbox"
                       class="form-check-input"
                       name="SelectedGenres"
                       value="@genre.Key"
                       id="genre-@genre.Key"
                @(Model.SelectedGenres.Contains(genre.Key) ? "checked" : "") />
                <label class="form-check-label" for="genre-@genre.Key">
                    @genre.Value
                </label>
            </div>
        }
    </div>
    <label asp-for="SelectedAuthors">Select Authors</label>
    <div class="form-group border border-black rounded">
        @foreach (var author in Model?.Authors)
        {
            <div class="form-check">
                <input type="checkbox"
                       class="form-check-input"
                       name="SelectedAuthors"
                       value="@author.Key"
                       id="author-@author.Key"
                @(Model.SelectedAuthors.Contains(author.Key) ? "checked" : "") />
                <label class="form-check-label" for="author-@author.Key">
                    @author.Value
                </label>
            </div>
        }
    </div>
    <div class="form-group">
        <div class="mb-3">
            <label asp-for="BookDescription" class="control-label">Re Enter Book Description</label>
            <input asp-for="BookDescription" class="form-control" />
            <span asp-validation-for="BookDescription" class="text-danger" />
        </div>
    </div>
    <button class="btn btn-primary">Add</button>
</form>
