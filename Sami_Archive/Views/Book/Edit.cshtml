@model UpdateBooksViewModel

<form asp-action="Edit" asp-route-BookID="@Model?.BookID" asp-route-BookTitle="@Model?.BookTitle" asp-route-BookDescription="@Model?.BookDescription" method="post" class="border border-black p-3 mb-3 col-6">
    <input asp-for="BookID" type="hidden" />
    <div class="form-group">
        <div class="mb-3 col-3">
            <label asp-for="BookTitle" class="form-label">Book Title</label>
            <input asp-for="BookTitle" class="form-control">
        </div>
    <div class="form-group">
         <div class="mb-3">
             <label asp-for="BookDescription" class="form-label">Book Description</label>
             <input asp-for="BookDescription" class="form-control" />
         </div>
    </div>
    </div>
    <div class="form-group">
        <label asp-for="SelectedGenres">Select Genre</label>
        <select asp-for="SelectedGenres"
                asp-items="@(new SelectList(Model.Genres, "Key", "Value"))"
                class="form-control">
        </select>
    </div>
    <div class="form-group">
        <label asp-for="SelectedAuthors">Select Author</label>
        <select asp-for="SelectedAuthors"
                asp-items="@(new SelectList(Model.Authors, "Key", "Value"))"
                class="form-control">
        </select>
    </div>
    <button class="btn btn-primary">Update</button>
</form>