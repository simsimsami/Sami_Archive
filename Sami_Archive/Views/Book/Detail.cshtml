@model Book

<div>
    <div>
        <img src="https://images6.alphacoders.com/652/thumb-350-652393.webp" />
        <div class="col">
            <h4>
                @Model?.BookTitle
            </h4>
            @foreach (var item in Model?.Genres)
            {
                <p>@item?.GenreTitle</p>
            }
        </div>
    </div>
</div>