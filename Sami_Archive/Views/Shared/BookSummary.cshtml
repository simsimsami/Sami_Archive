@model Book

<style>
    img {
        display: block;
        max-width: 20%;
        height: auto;
    }

    a, a:visited, a:hover, a:active {
        color: inherit;
    }
</style>


<div class="card btn btn-outline-dark mb-2 pb-3">
    <a asp-controller="Book"
       asp-action="Detail"
       asp-route-BookID="@Model?.BookID"
       class="text-decoration-none">
        <div class="card-body container text-center">
            <div class="row">
                <div class="col">
                    <img src="https://images6.alphacoders.com/652/thumb-350-652393.webp" class="rounded float-start height: auto" alt="..." />
                </div>
                <div class="col">
                    <h4>
                        @Model?.BookTitle
                    </h4>

                    
                </div>
                <div class="container">
                    <div class="row">
                        <div class="col-md-auto">
                            By
                        </div>
                        @foreach (var item in Model?.Authors)
                        {
                            <div class="col-md-auto">
                                @item?.AuthorName, 
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col">
                <a asp-controller="Book"
                   asp-action="Edit"
                   asp-route-BookID="@Model?.BookID"
                   class="btn btn-success btn-sm pull-right">Edit</a>
            </div>
            <div class="col">
                <a asp-controller="Book"
                   asp-action="DeleteForm"
                   asp-route-BookID="@Model?.BookID"
                   class="btn btn-danger btn-sm pull-right">Delete</a>
            </div>
        </div>
    </a>
</div>