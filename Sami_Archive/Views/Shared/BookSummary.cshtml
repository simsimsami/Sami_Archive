@model Book

<style>
    img {
        display: block;
        max-width: 20%;
        height: auto;
    }
</style>


<div class="card">
    <button type="button" class="btn btn-outline-dark">
        <div class="card-body container text-center">
            <div class="row">
                <div class="col">
                    <img src="https://images6.alphacoders.com/652/thumb-350-652393.webp" class="rounded float-start height: auto" alt="..." />
                </div>
                <div class="col">
                    <h4>@Model?.BookTitle</h4>
                    @foreach (var item in Model?.Genres)
                    {
                        <p>@item?.GenreTitle</p>
                    }
                </div>
            </div>
        </div>
    </button>
    <div class="row">
        <div class="col">
            <a asp-controller="Book"
               asp-action="Edit"
               asp-route-BookID="@Model?.BookID"
               class="btn btn-success btn-sm pull-right">Edit</a>
        </div>
        <div class="col">
            <a asp-controller="Book"
               asp-action="DeleteForm"
               asp-route-BookID="@Model?.BookID"
               class="btn btn-danger btn-sm pull-right">Delete</a>
        </div>
        <div class="col">
            <a asp-controller="Book"
               asp-action="Detail"
               asp-route-BookID="@Model?.BookID"
               class="btn btn-secondary btn-sm pull-right">Details</a>
        </div>
    </div>
</div>






