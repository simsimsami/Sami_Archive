@model Book

<div class="card card-outline-primary m-1 p-1">
    <div class="bg-faded p-1 col">
        <h4>
            @Model?.BookTitle
        </h4>
        <div class="card-text p-1">@Model?.BookDescription</div>
    </div>
    <div>
        <div class="card-text p-1 border border-black col">

            @foreach (var item in Model.Genres)
            {
                <div class="badge text-bg-primary">
                    @item.GenreTitle
                </div>
            }
        </div>
        <div class="card-text p-1 border border-black col">

            @foreach (var item in Model.Authors)
            {
                <div class="badge text-bg-info">
                    @item.AuthorName
                </div>
            }
        </div>
        <div class="row">
            <div class="col">
                <a asp-controller="Book"
                   asp-action="Edit"
                   asp-route-BookID="@Model?.BookID"
                   asp-route-BookTitle="@Model?.BookTitle"
                   asp-route-BookDescription="@Model?.BookDescription"
                   class="btn btn-success btn-sm pull-right">Edit</a>
            </div>
            <div class="col">
                <a asp-controller="Book"
                   asp-action="DeleteForm"
                   asp-route-BookID="@Model?.BookID"
                   class="btn btn-danger btn-sm pull-right">Delete</a>
            </div>
        </div>
    </div>
</div>