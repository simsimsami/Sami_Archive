@model Author


<div class="card card-outline-primary m-1 p-1">
    <div class="row">
        <div class="card-text p-1 badge text-bg-primary col">
            @Model?.AuthorName
        </div>
        <div class="col">
            <a asp-controller="Author"
               asp-action="Edit"
               asp-route-AuthorID="@Model?.AuthorID"
               class="btn btn-success btn-sm pull-right">Edit</a>
        </div>
        <div class="col">
            <a asp-controller="Author"
               asp-action="DeleteForm"
               asp-route-AuthorID="@Model?.AuthorID"
               class="btn btn-danger btn-sm pull-right">Delete</a>
        </div>
    </div>
</div>