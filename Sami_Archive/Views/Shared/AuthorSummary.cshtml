@model Author

<style>
    a, a:visited, a:hover, a:active {
        color: inherit;
    }
</style>

<div class="card btn btn-outline-dark mb-2 pb-3">
    <a asp-controller="Author"
       asp-action="Detail"
       asp-route-AuthorID="@Model?.AuthorID"
       class="text-decorate-none">
        <div class="text-decoration-none">
            <div class="col">
                <h4>
                    @Model?.AuthorName
                </h4>
            </div>

        </div>
    </a>
    <div class="row">
        <div class="col">
            <a asp-controller="Author"
               asp-action="Edit"
               asp-route-AuthorID="@Model?.AuthorID"
               class="btn btn-success btn-sm pull-right">Edit</a>
        </div>
        <div class="col">
            <a asp-controller="Author"
               asp-action="DeleteForm"
               asp-route-AuthorID="@Model?.AuthorID"
               class="btn btn-danger btn-sm pull-right">Delete</a>
        </div>
    </div>
</div>