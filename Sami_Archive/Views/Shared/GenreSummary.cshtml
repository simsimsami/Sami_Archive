@model Genre

<style>
    a, a:visited, a:hover, a:active {
        color: inherit;
    }
</style>

<div class="card card-outline-primary m-3">
    <div class="row">
        <div class="card-textbadge badge text-bg-primary col">
            @Model?.GenreTitle
        </div>
        <div class="col">
            <a asp-controller="Genre"
               asp-action="Edit"
               asp-route-GenreID="@Model?.GenreID"
               class="btn btn-success btn-sm pull-right">Edit</a>
        </div>
        <div class="col">
            <a asp-controller="Genre"
               asp-action="DeleteForm"
               asp-route-GenreID="@Model?.GenreID"
               class="btn btn-danger btn-sm pull-right">Delete</a>
        </div>
    </div>
</div>
